{
  "name": "aula-quiz",
  "private": true,
  "version": "0.1.0",
  "description": "Aula Quiz: juego de preguntas en directo para el aula",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
